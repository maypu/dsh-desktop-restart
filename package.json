{
  "name": "dsh-desktop-restart",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Quick restart button for the whole DeepSeek Harness desktop app on Windows / macOS / Linux (incl. Flatpak / Snap / AppImage), with a settings page to choose where it appears.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop",
    "restart"
  ],
  "license": "MIT",
  "author": "maypu",
  "repository": {
    "type": "git",
    "url": "https://github.com/maypu/dsh-desktop-restart.git"
  },
  "homepage": "https://github.com/maypu/dsh-desktop-restart#readme",
  "bugs": {
    "url": "https://github.com/maypu/dsh-desktop-restart/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
